# Memo configuration. `npm run setup` in the kit folder writes .env from this file and fills in each
# [PLACEHOLDER]. By hand: copy this file to .env, replace each [PLACEHOLDER], then run: chmod 600 .env
# Do not commit .env.
HOST=127.0.0.1
PORT=3280
DATABASE_PATH=./data/memo.db
# Only for a computer that runs a remote agent: the address of the Memo server on a different computer.
# MEMO_URL=https://[TAILSCALE_HOST]
# The name of the person who owns the queue. Agents send memos to this name. Only a-z, 0-9 and "-".
MEMO_OWNER=[MEMO_OWNER]
# The full name of the owner, for the commit messages of the System page.
MEMO_OWNER_NAME=[YOUR_NAME]
# The token of the owner and of the agents. It can do all operations. Setup makes a random one and never shows it.
# By hand: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEMO_TOKEN=[MEMO_TOKEN]

# The time zone of the owner, for the ticks and for a postponed memo that comes back at 9:00 AM.
MEMO_TZ=[YOUR_TIMEZONE]
# Ticks (optional): small actions of the owner that come back, in the Inbox list. They are off by default.
# MEMO_TICKS=1
# The hour at which a new day of the ticks starts.
# MEMO_DAY_START=3

# The vault of notes that the agents keep, and the System page reads. See the README of the kit.
MEMO_VAULT=[VAULT_PATH]
# The folder of the sign-in of the second Claude account, for the nightly skills sync (scripts/skills-sync.js).
MEMO_SECOND_CONFIG_DIR=[SECOND_CLAUDE_CONFIG_DIR]
# The System page compares the branch of this code with its copy on GitHub: the local branch, the git remote, and
# the branch there. The defaults are main, origin, and the name of the local branch.
# MEMO_CODE_BRANCH=main
# MEMO_CODE_REMOTE=origin
# MEMO_CODE_REMOTE_BRANCH=main

# Calendar (optional): the secret iCal address of your Google Calendar, for the Today card of the Inbox.
# Easier: add the calendar on the Inbox page. It is a secret: anyone with it can read your calendar.
# For several calendars, put the addresses on one line, separated by commas.
# MEMO_CALENDAR_ICS=
# Meeting follow-ups: the agent main gets one memo 30 minutes after each meeting of a work calendar ends. The calendars
# are those of MEMO_CALENDAR_ICS and those added on the Inbox page. MEMO_FOLLOWUPS=0 turns the follow-ups off.
# MEMO_FOLLOWUP_DELAY_MIN changes the 30 minutes.
# MEMO_FOLLOWUP_DOMAIN is the work domain: only a calendar whose owner (the mail address in the secret address) is on
# it gives follow-ups, so a personal calendar gives none. With no value: the domain of the first calendar that is not
# at a personal mail service such as gmail.com; with no such calendar, no follow-ups.
# MEMO_FOLLOWUPS=0
# MEMO_FOLLOWUP_DELAY_MIN=30
MEMO_FOLLOWUP_DOMAIN=[YOUR_WORK_DOMAIN]

# Tailscale. With the two lines below, the owner needs no token on the pages through Tailscale Serve (the phone).
# The login name of your Tailscale account, and the host name and port that Tailscale Serve gives for Memo.
# Set both, or put a "#" before both.
MEMO_TAILSCALE_LOGIN=[TAILSCALE_LOGIN]
MEMO_TAILSCALE_HOST=[TAILSCALE_HOST]:8443

# Phone push (optional): when an agent is blocked, one short line goes to this ntfy topic (https://ntfy.sh).
# Use a long random name: anyone who knows it can read the alerts. Subscribe to it in the ntfy app.
MEMO_NTFY_TOPIC=[NTFY_TOPIC]
# Text message (optional, macOS): when an agent is blocked, the same one line goes as an iMessage from the Messages app
# on this Mac to a phone number with its country code, or to an Apple ID mail address, usually your own.
# Messages must be signed in to iMessage on the Mac. Both this and MEMO_NTFY_TOPIC can be on.
# MEMO_ALERT_IMESSAGE=

# The folder of your own pictures of the pets (optional). The default is ~/memo-pets.
# MEMO_PETS_DIR=

# Inbox from anywhere (optional, advanced): the Inbox on GitHub Pages, through a private repository. See app/README.md.
# MEMO_LEDGER_REPO=
# MEMO_LEDGER_TOKEN=
